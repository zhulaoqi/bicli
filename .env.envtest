# ─── BiCLI envtest 配置 ───────────────────────────────────────────────────────
# PROFILE=envtest 时自动加载本文件。
# 敏感配置（DB_PASSWORD / LLM API Key / Token）放 Apollo 或发布平台环境变量，不放代码仓库。

# ─── Apollo ───
# 对应 Apollo/Spring 配置：
#   app.id       -> APOLLO_APP_ID
#   apollo.meta  -> APOLLO_META
APOLLO_META=http://172.30.10.48:8080
APOLLO_APP_ID=bicli
APOLLO_CLUSTER=default
APOLLO_NAMESPACE=application

# ─── MySQL ───
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=bicli

# ─── LLM ───
# 至少配置一个模型 Key；推荐从 Apollo 下发。
ALIBABA_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=

# 自建 OpenAI 兼容接口（可选）
#CUSTOM_API_URL=
#CUSTOM_API_KEY=
#CUSTOM_MODEL=

# ─── DataEye 集成 ───
PERMISSION_MODE=dataeye
DATAEYE_API_URL=http://dataeye-test.funsdata.com
DATAEYE_API_TIMEOUT=10000
DATAEYE_MAX_RETRIES=3

# ─── Datart 集成（可选）───
DATART_API_URL=http://dataeye-test.funsdata.com
DATART_API_TOKEN=
DATART_FRONTEND_URL=http://dataeye-test.funsdata.com
DATART_MAX_RETRIES=3

# ─── MCP HTTP Server ───
# 服务监听端口
MCP_HTTP_PORT=3211
# 服务监听地址：容器里必须是 0.0.0.0，不能写 http://...
MCP_HTTP_HOST=0.0.0.0
# Ingress/前端统一前缀；服务端会自动剥离此前缀后路由
MCP_BASE_PATH=/bicli-mcp
# 允许访问 BiCLI 的 DataEye 前端 origin，只写协议+域名+端口，不带 /api 路径
MCP_CORS_ORIGIN=http://dataeye-test.funsdata.com

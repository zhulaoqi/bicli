# ─── MySQL ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bicli

# ─── LLM API Keys（至少配置一个，自动检测可用 provider）───
ALIBABA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── 自定义模型（可选，用于接入私有/自建 OpenAI 兼容接口）───
# CUSTOM_MODEL_ENDPOINT=https://your-api.example.com/v1
# CUSTOM_MODEL_API_KEY=sk-xxx
# CUSTOM_MODEL_NAME=your-model-name

# ─── Web GUI（可选）─────────────────────────────
# WEB_PORT=3210
# WEB_HOST=127.0.0.1

# ─── 权限适配器（可选，默认 local）─────────────
# PERMISSION_MODE=local          # local | http
# PERMISSION_API_URL=            # http 模式必填，宿主系统权限 API 基地址
# PERMISSION_API_TIMEOUT=5000    # http 模式超时（毫秒）

# ─── MCP HTTP Server（可选）─────────────────────
# MCP_HTTP_PORT=3211
# MCP_HTTP_HOST=0.0.0.0
# MCP_CORS_ORIGIN=*
